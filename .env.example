# ---------------------------------------------------------------------------
# DigitalOcean "Anatomy of a Data Pipeline" demo – environment
# Copy to .env (never commit .env). Nothing here is required for mock mode.
# ---------------------------------------------------------------------------

# Server
PORT=8080
# mock  -> no credentials, simulated stages + local hash-embedding store (default)
# real  -> DigitalOcean Spaces + pgvector + Serverless Inference (see below)
PIPELINE_MODE=mock
# Slow down / speed up simulated stage timing in mock mode (1 = realistic, 0 = instant)
MOCK_DELAY_SCALE=1
# When a real-mode stage fails (network, credentials...), replay the most recent
# recording of the same flow so the stage demo never goes dark. true|false
REPLAY_FALLBACK=true
# Directory for recordings/*.json
RECORDINGS_DIR=./recordings

# --- real mode: Spaces (S3-compatible object storage) -----------------------
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=anatomy-demo
# Optional, defaults to https://<region>.digitaloceanspaces.com
DO_SPACES_ENDPOINT=

# --- real mode: Functions (optional) ---------------------------------------
# HTTP URL of a DigitalOcean Function that chunks + embeds. If empty the server
# performs chunking/embedding itself and labels the stage accordingly.
DO_FUNCTION_URL=

# --- real mode: Managed Postgres with pgvector ------------------------------
# e.g. postgresql://doadmin:...@db-postgresql-nyc3-12345-do-user-1.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL=
# Table used for chunks (created automatically with CREATE EXTENSION vector)
PGVECTOR_TABLE=anatomy_chunks

# --- real mode: Serverless Inference (OpenAI-compatible) --------------------
DO_INFERENCE_URL=https://inference.do-ai.run/v1
DO_INFERENCE_KEY=
DO_INFERENCE_MODEL=llama3.3-70b-instruct
# Embedding model served by the same endpoint. Leave empty to use the local
# hash embedding (128 dims) – handy when no embedding model is provisioned.
DO_EMBEDDING_MODEL=
# Must match the embedding model's output size (128 for the local embedder).
VECTOR_DIM=128

# --- real mode: GenAI Platform Agent (optional) -----------------------------
# If set, questions are routed to a Managed Agent (which owns its Knowledge
# Base) instead of the in-process RAG over pgvector.
DO_AGENT_ENDPOINT=
DO_AGENT_KEY=

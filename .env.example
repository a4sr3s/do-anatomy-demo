# ---------------------------------------------------------------------------
# DigitalOcean "Anatomy of a Data Pipeline" demo – environment
# Copy to .env (never commit .env). Nothing here is required for mock mode.
# ---------------------------------------------------------------------------

# Server
PORT=8080

# --- demos hub handoff (required in production on App Platform) --------------
# Shared secret with https://demos.alexisreyes.com. Visitors arrive via
# GET /auth/handoff?token=<jwt>; everything else needs the demo_session cookie.
# Until this is set in production, the app fails closed (redirect to the hub /
# 401 JSON) but /api/health and /mcp/health still respond so deploys succeed.
# Local dev: leave empty to skip the gate, or set and use `npm run mint:handoff`.
DEMO_HANDOFF_SECRET=
# Optional: force the gate on/off (default: on in NODE_ENV=production, or when secret is set)
# DEMO_HANDOFF_GATE=false
# mock  -> no credentials, simulated stages + local hash-embedding store (default)
# real  -> DigitalOcean Spaces + pgvector + a Harness Runtime session (gpt-oss-20b on
#          Serverless Inference) reached through the Action Gateway / MCP tools (see below)
PIPELINE_MODE=mock
# Slow down / speed up simulated stage timing in mock mode (1 = realistic, 0 = instant)
MOCK_DELAY_SCALE=1
# When a real-mode stage fails (network, credentials...), replay the most recent
# recording of the same flow so the stage demo never goes dark. true|false
REPLAY_FALLBACK=true
# Directory for recordings/*.json
RECORDINGS_DIR=./recordings

# --- real mode: Spaces (S3-compatible object storage) -----------------------
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=anatomy-demo
# Optional, defaults to https://<region>.digitaloceanspaces.com
DO_SPACES_ENDPOINT=

# Chunking + embedding run inside this App Platform web service right after the
# Spaces PUT (SSE stage `functions` is only the wire name); there is no separate
# DO Function to configure.

# --- real mode: Managed Postgres with pgvector ------------------------------
# e.g. postgresql://doadmin:...@db-postgresql-nyc3-12345-do-user-1.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL=
# Optional: the cluster's CA certificate (control panel -> database -> Connection
# details -> Download CA certificate), PEM text. When set the TLS chain is
# verified against it; literal "\n" sequences are accepted so it fits on one
# line (App Platform SECRET). When empty and sslmode=require, TLS is used
# without chain verification (DO's per-cluster CA is not in the system store).
DATABASE_CA_CERT=
# Table used for chunks (created automatically with CREATE EXTENSION vector)
PGVECTOR_TABLE=anatomy_chunks

# --- real mode: how questions get answered (architecture v4) ----------------
# Every question goes to a Harness Runtime session (OpenCode + gpt-oss-20b on
# Serverless Inference) which retrieves through the anatomy-data MCP tools
# (mcp/) via the Action Gateway -> pgvector / Spaces, and streams the answer
# back. Context-in-prompt fallback (still inside the harness): if the MCP
# health check fails, HARNESS_TOOLS_MODE=none, or the agent answers without a
# usable tool result, the app retrieves itself and passes the context in the
# prompt. If the harness fails before its first token the question errors and,
# with REPLAY_FALLBACK=true, a recording is replayed. There is no other model
# backend.

# --- real mode: Harness Runtime (Managed Agents) ------------------------------
# DigitalOcean API token with Managed Agents access. DIGITALOCEAN_ACCESS_TOKEN
# is used as a fallback when this is empty.
HARNESS_API_TOKEN=
# Serverless Inference key the model inside the session uses (secret slot
# HARNESS_INFERENCE_API_KEY in the session manifest).
HARNESS_INFERENCE_API_KEY=
HARNESS_SESSION_NAME=alexis-anatomy-harness-v4
HARNESS_MODEL=openai-gpt-oss-20b
HARNESS_SIZE=mars-1vcpu-1gb
HARNESS_IDLE_TIMEOUT=30m
# gateway (default) -> the manifest selects do.actions tools (HARNESS_GATEWAY_TOOLS) after the
#                      MCP server was registered as an Action Gateway custom provider
# inline            -> the manifest declares the MCP server below directly (tools: name/url/auth)
# none              -> no tools; context is passed in the prompt
HARNESS_TOOLS_MODE=gateway
# Comma list of gateway tool slugs (<serverRef>_<tool>), used with HARNESS_TOOLS_MODE=gateway.
# Empty -> anatomy-data_search_facts,anatomy-data_get_document (serverRef anatomy-data)
HARNESS_GATEWAY_TOOLS=
# Nothing streamed (no token, no tool activity) within this window -> the run fails (and the
# server replays a recording with REPLAY_FALLBACK). The session's event stream is attached once
# and kept open, so 15 s is already a real failure; the old 45 s only delayed the replay.
HARNESS_FIRST_TOKEN_TIMEOUT_MS=15000
# Persistent event stream (GET /events, one per session): attach timeout and the silence after
# which it is re-attached with Last-Event-ID (the server sends a keepalive every ~15 s).
HARNESS_ATTACH_TIMEOUT_MS=20000
HARNESS_STREAM_IDLE_MS=60000
# MCP health (GET <MCP_PUBLIC_URL>/health) is cached this long and refreshed in the background,
# so no question waits for it (it is primed at warm-up).
MCP_HEALTH_TTL_MS=30000
# Whole-run limit
HARNESS_TIMEOUT_MS=90000
# gpt-oss reasoning effort: off (default) | low | medium | high. The input API has no
# parameter for it, so the Harmony line "Reasoning: low" leads every prompt; off sends none.
# Default off: "low" made gpt-oss-20b answer "I do not know" despite a matching search hit.
HARNESS_REASONING_EFFORT=off

# --- session hygiene: create from an Environment Config and rotate ----------
# Immutable Environment Config the session is created from (JSON create
# {name, config_id}; nothing new is persisted). Unset -> the config of the live
# alexis-anatomy-harness-v4b session. `none` (or empty) -> the YAML manifest path
# above and no rotation.
HARNESS_CONFIG_ID=01a132ee-ff11-7130-9d05-838874ecec77
# Rotate the session in the background (new <name>-r<ts> session created, warmed,
# switched in between questions, old one deleted) after this many questions
# (0 disables) or when it sat idle longer than this before a question (0 disables).
HARNESS_ROTATE_AFTER=15
HARNESS_ROTATE_IDLE_MS=1200000

# --- answer path -------------------------------------------------------------
# search-first (default): the app embeds the question and searches pgvector at
#   once, then ONE model round writes the answer with the facts in the prompt
#   (first token ~0.6 s cached / ~0.9 s cold). The model still writes every
#   answer, also "I do not know that yet.".
# tool: the agent in the harness session calls search_facts itself through the
#   Action Gateway (two model rounds + the gateway hop, ~3.7 s to the first token).
ANSWER_MODE=search-first
# Where the search-first model round runs: harness (the Harness Runtime
# session, rotation applies) or direct (streaming /chat/completions on
# Serverless Inference with HARNESS_INFERENCE_API_KEY, keep-alive connection;
# a direct round that fails before its first token is retried in the harness).
SEARCH_FIRST_BACKEND=direct
# gpt-oss reasoning effort of that single round: off | low | medium | high.
# `low` is the `reasoning_effort` API parameter on the direct backend and the
# "Reasoning: low" prompt line in the harness (measured: fewer reasoning tokens,
# correctness unchanged on the context prompt; see bench/SEARCH_FIRST.md).
SEARCH_FIRST_REASONING_EFFORT=low
# Query-embedding cache (questions -> vectors, LRU, in memory): a repeated
# question skips the /embeddings round trip. 0 disables.
EMBED_CACHE_SIZE=256
# Holders of MCP_AUTH_TOKEN may override the three knobs per question with
# POST /api/ask {question, mode, backend, effort} + x-tool-event-token (benchmarks).
# The UI toggle sends the public presets POST /api/ask {question, mode: "fast" | "agent"}:
# fast = search-first / direct / low, agent = tool. Neither changes the defaults above.
# POST /api/harness/warm (public, throttled 10 s) thaws a paused harness session so Agent
# mode is ready; the UI calls it when the toggle switches to Agent.

# --- v4: anatomy-data MCP tool server (mcp/, `npm run start:mcp`) -----------
# Public URL of the MCP server as the harness / gateway reaches it. In App
# Platform the `mcp` component serves /mcp (route /mcp, prefix preserved).
# GET <MCP_PUBLIC_URL>/health is the pre-flight check before each question.
MCP_PUBLIC_URL=https://do-anatomy-demo-lfmw4.ondigitalocean.app/mcp
# Shared secret: bearer token on /mcp AND x-tool-event-token on
# POST /api/internal/tool-event. Set the same value on both services.
# The MCP server refuses to start without it.
MCP_AUTH_TOKEN=
# Where the MCP server reports tool calls (the web service). In App Platform
# use the internal URL http://web:8080/api/internal/tool-event
TOOL_EVENT_URL=http://localhost:8080/api/internal/tool-event
# Port of the MCP server when run locally
# PORT=8081

# --- real mode: Serverless Inference, embeddings only (OpenAI-compatible) ----
# Answer generation always happens inside the harness session (HARNESS_MODEL +
# HARNESS_INFERENCE_API_KEY above). These two only serve the optional remote
# embedding model used by ingest and the MCP server's search_facts.
DO_INFERENCE_URL=https://inference.do-ai.run/v1
# Model Access Key. These can ONLY be created in the control panel
# (Serverless Inference -> Model access keys); doctl/API cannot mint them.
# When empty, HARNESS_INFERENCE_API_KEY is used for /embeddings instead.
DO_INFERENCE_KEY=
# Embedding model served by that endpoint (needs DO_INFERENCE_KEY or
# HARNESS_INFERENCE_API_KEY). Production uses the multilingual bge-m3 (1024
# dims, relevance floor 0.52). Leave empty to use the local hash embedding
# (128 dims, floor 0.08) – handy when no key is available; retrieval then
# works entirely without a key. The web and mcp services must agree.
DO_EMBEDDING_MODEL=
# Must match the embedding model's output size (1024 for bge-m3, 128 for the
# local embedder). On boot the web service compares it with the pgvector
# column and, if different, recreates the column and re-embeds every row
# (also: npm run migrate:embeddings [-- --force]).
VECTOR_DIM=128

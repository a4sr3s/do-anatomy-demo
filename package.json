{
  "name": "do-anatomy-demo",
  "version": "0.1.0",
  "private": true,
  "description": "DigitalOcean live data pipeline shown as an interactive 3D isometric anatomy scene, driven by real backend events over SSE.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "start:mcp": "node mcp/index.js",
    "mint:handoff": "node scripts/mint-handoff-token.js",
    "test": "node --test test/handoff.test.js test/mock-pipeline.test.js test/recorder.test.js test/real-pipeline.test.js test/harness.test.js test/search-first.test.js test/mcp.test.js test/tool-events.test.js test/retrieval.test.js test/migrate.test.js test/mode-toggle.test.js",
    "migrate:embeddings": "node scripts/migrate-embeddings.js",
    "record:samples": "node scripts/record-samples.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "lucide-react": "^1.55.0",
    "pg": "^8.13.1",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}

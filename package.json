{
  "name": "do-anatomy-demo",
  "version": "0.1.0",
  "private": true,
  "description": "DigitalOcean live data pipeline shown as an interactive 3D isometric anatomy scene, driven by real backend events over SSE.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/mock-pipeline.test.js test/recorder.test.js",
    "record:samples": "node scripts/record-samples.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
